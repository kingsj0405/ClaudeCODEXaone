{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "grep *": "allow"
    }
  },
  "model": "exaone/k-exaone_v2.5",
  "share": "disabled",
  "provider": {
    "exaone": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "EXAONE API Platform",
      "options": {
        "baseURL": "https://api.exaone.ai/v1",
        "apiKey": "{env:EXAONE_API_KEY}"
      },
      "models": {
        "k-exaone_v2.5": {
          "name": "K-EXAONE 2.5",
          "tool_call": true,
          "reasoning": true,
          "options": { "reasoning_effort": "medium" },
          "limit": { "context": 524288, "output": 32768 }
        }
      }
    }
  }
}
